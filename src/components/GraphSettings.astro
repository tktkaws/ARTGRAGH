---
import Icon from './Icon.astro';
import { DEFAULT_SETTINGS } from '../lib/graph/model';
import { regionCounts } from '../lib/graph/build';
import { KIND_LABELS, PERIOD_LABELS } from '../lib/graph/classification';
---
<aside class="settings panel" id="settings-panel" aria-label="グラフ設定">
  <div class="panel-heading"><span><Icon name="settings" size={17} /> グラフ設定</span><div class="heading-actions"><button class="icon-button" id="reset-settings" title="設定をリセット" aria-label="設定をリセット"><Icon name="reset" size={16} /></button><button class="icon-button" data-close="settings" aria-label="設定を閉じる"><Icon name="close" size={18} /></button></div></div>
  <div class="panel-scroll">
    <details open><summary><Icon name="chevron" size={15} />フィルタ</summary><div class="section-content">
      <label class="field-label" for="region-filter">地域</label><select id="region-filter"><option value="">すべての地域</option>{regionCounts.map(region => <option value={region.id}>{region.label}（{region.count}作品）</option>)}</select>
      <label class="field-label filter-label" for="period-filter">年代</label><select id="period-filter"><option value="">すべての年代</option>{Object.entries(PERIOD_LABELS).map(([id, label]) => <option value={id}>{label}</option>)}</select>
      <label class="field-label filter-label" for="kind-filter">種類</label><select id="kind-filter"><option value="">すべての種類</option>{Object.entries(KIND_LABELS).map(([id, label]) => <option value={id}>{label}</option>)}</select>
      <p class="field-hint">3項目を組み合わせて絞り込めます。年代は制作開始年を基準に分類しています。</p>
      <label class="switch-row"><span>孤立ノードを表示</span><input id="show-orphans" type="checkbox" data-setting="showOrphans" checked={DEFAULT_SETTINGS.showOrphans} /><span class="toggle" aria-hidden="true"></span></label></div></details>
    <div class="section-content node-image-setting"><label class="switch-row"><span>作品画像で表示</span><input id="image-nodes" type="checkbox" data-setting="imageNodes" checked={DEFAULT_SETTINGS.imageNodes} /><span class="toggle" aria-hidden="true"></span></label></div>
    <div class="panel-footnote"><span class="status-dot"></span>設定はこのブラウザに保存されます</div>
  </div>
</aside>
